    }
  }

  // versenynév-lista (a táblázat „Versenyek” lapjáról), szabad beírással
  let races=[];
  if(isRace){
    const dl=el("datalist",{id:"raceNames"});
    iTitle.setAttribute("list","raceNames");
    iTitle.setAttribute("autocomplete","off");
    form.append(dl);
    call("listRaces").then(list=>{
      races=list||[];
      races.forEach(r=>dl.append(el("option",{value:r.name,label:[r.date&&fmtDayShort(r.date),r.place].filter(Boolean).join(" · ")})));
    }).catch(()=>{});
    let lastPicked="";
    const pickRace=()=>{
      const v=iTitle.value.trim().toLowerCase();
      const r=races.find(x=>x.name.toLowerCase()===v);
      if(!r || r.name===lastPicked) return;
      lastPicked=r.name;
      if(r.type){ const rb=form.querySelector("#rt-"+r.type); if(rb) rb.checked=true; }
      if(r.date) iDate.value=r.date;
      if(r.distance) iDist.value=r.distance;
      if(r.place) iPlace.value=r.place;
      if(r.link) iLink.value=r.link;
      if(r.note && !iDesc.value.trim()) iDesc.value=r.note;
      updateLinkPreview();
    };
    iTitle.addEventListener("input",pickRace);
    iTitle.addEventListener("change",pickRace);
  }

  // heti ismétlés (csak új edzésnél)
  const defUntil=(()=>{ const d=parseYmd(e.date); d.setDate(d.getDate()+7*11); return ymd(d); })();
  const iRep=el("input",{type:"checkbox"});
  const iUntil=el("input",{type:"date",value:defUntil});
  const untilWrap=el("label",{class:"f",style:"display:none"},"Utolsó alkalom legkésőbb",iUntil);
  iRep.addEventListener("change",()=>{ untilWrap.style.display=iRep.checked?"":"none"; });
  const repField=(!existing && !isRace) ? el("div",{class:"repeat"},el("label",{class:"chk"},iRep,"🔁 Hetente ismétlődik"),untilWrap) : null;
  let scope="one";
  const scopeField = existing && existing.seriesId ? el("div",{class:"repeat"},
    el("p",{class:"section-title",style:"margin:0 0 4px"},"Ismétlődő edzés"),
    el("label",{class:"chk"},el("input",{type:"radio",name:"scope",value:"one",checked:true,onchange:()=>scope="one"}),"Csak ezt az alkalmat módosítom"),
    el("label",{class:"chk"},el("input",{type:"radio",name:"scope",value:"future",onchange:()=>scope="future"}),"Ezt és az összes következőt")) : null;

  const err=el("div",{class:"err"});
  const save=el("button",{class:"btn dark",type:"submit"},existing?"Mentés":"Hozzáadás");
  form.append(
    el("div",{class:"body"},
      el("div",{},el("p",{class:"section-title"},isRace?"Verseny típusa":"Sportág"),pick),
      f(isRace?"Verseny neve":"Megnevezés",iTitle),
      el("div",{class:"row3"},f("Dátum",iDate),f(isRace?"Rajt":"Kezdés",iStart),f("Vége",iEnd)),
      el("div",{class:"row"},f("Helyszín",iPlace),f(isRace?"Táv":"Táv / jelleg",iDist)),
      (isRace||e.link) && el("div",{},f("Link",iLink),linkPreview), f(isRace?"Megjegyzés":"Leírás",iDesc), repField, scopeField, err),
    el("footer",{},el("button",{class:"btn",type:"button",onclick:()=>existing?openDetail(existing.id):closeModal()},"Mégse"),save));
  form.addEventListener("submit",async(ev)=>{
    ev.preventDefault();
    const sport=isRace?"race":(form.querySelector('input[name=sport]:checked')?.value||"other");
    const raceType=isRace?(form.querySelector('input[name=raceType]:checked')?.value||"other"):"";
    if(isRace && !iTitle.value.trim()){ err.textContent="Add meg a verseny nevét."; return; }
    if(!iDate.value){ err.textContent="Add meg a dátumot."; return; }
    if(iStart.value && iEnd.value && iEnd.value<iStart.value){ err.textContent="A vége nem lehet a kezdés előtt."; return; }
    const repeating = !!repField && iRep.checked;
    if(repeating && (!iUntil.value || iUntil.value<=iDate.value)){ err.textContent="Az utolsó alkalom legyen későbbi, mint az első."; return; }
    const data={id:existing?existing.id:"",sport,raceType,title:iTitle.value.trim(),date:iDate.value,start:iStart.value,end:iEnd.value,
      place:iPlace.value.trim(),distance:iDist.value.trim(),desc:iDesc.value.trim(),link:iLink.value.trim(),organizer:state.me};
    save.disabled=true; save.textContent="Mentés…";
    try{
      apply(await call("saveEvent", data, auth(), {repeatUntil: repeating?iUntil.value:"", scope}));
      const d=parseYmd(data.date); state.cursor=new Date(d.getFullYear(),d.getMonth(),1);
      closeModal(); renderAll();
    }catch(x){ err.textContent=msg(x); save.disabled=false; save.textContent=existing?"Mentés":"Hozzáadás"; }
  });
  updateLinkPreview();
  openModal(existing?(isRace?"Verseny szerkesztése":"Edzés szerkesztése"):(isRace?"🏆 Új verseny":"Új közös edzés"), form);
}
function firstEnabled(){ return Object.keys(SPORTS).find(k=>k!=="race"&&state.enabled[k])||"run"; }
function msg(x){ const m=(x&&x.message)||""; return m && m.length<120 ? "Hiba: "+m.replace(/^Error:\s*/,"") : "Nem sikerült menteni, próbáld újra."; }
function setStatus(t,warn){ const s=document.getElementById("status"); s.textContent=t; s.classList.toggle("warn",!!warn); }

/* ---------- controls ---------- */
document.getElementById("prev").onclick=()=>{ state.cursor=new Date(state.cursor.getFullYear(),state.cursor.getMonth()-1,1); renderAll(); };
document.getElementById("next").onclick=()=>{ state.cursor=new Date(state.cursor.getFullYear(),state.cursor.getMonth()+1,1); renderAll(); };
document.getElementById("todayBtn").onclick=()=>{ const d=new Date(); state.cursor=new Date(d.getFullYear(),d.getMonth(),1); renderAll(); };
document.getElementById("vMonth").onclick=()=>{ state.view="month"; renderAll(); };
document.getElementById("vList").onclick=()=>{ state.view="list"; renderAll(); };
document.getElementById("allOn").onclick=()=>{ for(const k in SPORTS) state.enabled[k]=true; saveFilters(); renderAll(); };
document.getElementById("allOff").onclick=()=>{ for(const k in SPORTS) state.enabled[k]=false; saveFilters(); renderAll(); };
document.getElementById("addBtn").onclick=()=>openForm(null);
document.getElementById("addRaceBtn").onclick=()=>newRace(null);
let rT; addEventListener("resize",()=>{ clearTimeout(rT); rT=setTimeout(()=>{ if(state.view==="month") renderMonth(); },150); });

renderAll();
refresh();
setInterval(()=>{ if(!document.hidden && !scrim.classList.contains("open")) refresh(); }, 60000);
document.addEventListener("visibilitychange",()=>{ if(!document.hidden) refresh(); });
</script>
</body>
</html>
