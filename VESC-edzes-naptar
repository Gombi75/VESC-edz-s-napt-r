<!DOCTYPE html>
<html lang="hu">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>VESC közös edzések naptár</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#f6f7f9; --panel:#ffffff; --ink:#1b1f24; --muted:#6b7280; --line:#e5e7eb; --soft:#f1f3f5;
    --run:#f28c28; --run-bg:#fff1e3;
    --bike:#2e9e5b; --bike-bg:#e5f5ec;
    --swim:#2f7fd8; --swim-bg:#e5f0fc;
    --other:#7b8290; --other-bg:#eef0f3;
    --race:#d63c3c; --race-bg:#fde8e8;
    --accent:#1b1f24; --today:#1b1f24;
    --radius:12px;
  }
  @media (prefers-color-scheme: dark){
    :root{
      --bg:#121417; --panel:#1b1e23; --ink:#eceef1; --muted:#9aa1ab; --line:#2b3037; --soft:#22262c;
      --run-bg:#3a2717; --bike-bg:#17321f; --swim-bg:#172a42; --other-bg:#2a2e34; --race-bg:#3d1d1d;
      --accent:#eceef1; --today:#eceef1;
    }
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%}
  body{font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--ink);font-size:14px}
  button{font:inherit;color:inherit;cursor:pointer}
  input,select,textarea{font:inherit;color:var(--ink);background:var(--panel)}
  .app{display:grid;grid-template-columns:270px 1fr;min-height:100vh}
  aside{background:var(--panel);border-right:1px solid var(--line);padding:20px 16px;display:flex;flex-direction:column;gap:20px}
  .brand h1{font-size:18px;margin:0 0 2px;font-weight:700;letter-spacing:-.01em}
  .brand p{margin:0;color:var(--muted);font-size:12.5px}
  .btn-primary{background:var(--accent);color:var(--panel);border:0;border-radius:10px;padding:11px 14px;font-weight:600;width:100%;display:flex;align-items:center;justify-content:center;gap:8px}
  .btn-secondary{background:var(--race-bg);color:var(--ink);border:1.5px solid var(--race);border-radius:10px;padding:9px 14px;font-weight:600;width:100%;margin-top:-12px}
  .btn-secondary:hover{filter:brightness(.97)}
  .btn-primary:disabled{opacity:.45;cursor:not-allowed}
  .section-title{font-size:11.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:600;margin:0 0 8px}
  .filters{display:flex;flex-direction:column;gap:4px}
  .filter{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:9px;cursor:pointer;user-select:none}
  .filter:hover{background:var(--soft)}
  .filter input{position:absolute;opacity:0;pointer-events:none}
  .check{width:18px;height:18px;border-radius:5px;border:2px solid var(--c);display:grid;place-items:center;flex:none;transition:background .12s}
  .check svg{width:11px;height:11px;opacity:0}
  .filter input:checked + .check{background:var(--c)}
  .filter input:checked + .check svg{opacity:1}
  .filter input:focus-visible + .check{outline:2px solid var(--c);outline-offset:2px}
  .filter .emoji{font-size:16px}
  .filter .name{flex:1;font-weight:500}
  .filter .count{color:var(--muted);font-size:12px;font-variant-numeric:tabular-nums}
  .filter.off .name,.filter.off .emoji{opacity:.45}
  .filter-actions{display:flex;gap:12px;padding:4px 10px 0}
  .linkbtn{background:none;border:0;padding:0;color:var(--muted);font-size:12px;text-decoration:underline;text-underline-offset:2px}
  .upcoming{display:flex;flex-direction:column;gap:6px;overflow:auto}
  .up{display:flex;gap:10px;align-items:flex-start;padding:8px 10px;border-radius:9px;background:var(--soft);border:0;text-align:left;width:100%}
  .up .bar{width:4px;align-self:stretch;border-radius:2px;background:var(--c);flex:none}
  .up .t{font-weight:600;font-size:13px;line-height:1.3}
  .up .m{color:var(--muted);font-size:12px;margin-top:2px}
  .empty{color:var(--muted);font-size:12.5px;padding:4px 2px}
  .me{margin-top:10px;font-size:13px}
  .muted{color:var(--muted)}
  .admin-badge{display:inline-block;background:var(--soft);border-radius:999px;padding:2px 8px;font-size:12px;font-weight:600}
  .keybox{background:var(--soft);border-radius:10px;padding:10px 12px;display:flex;flex-direction:column;gap:6px}
  .keyrow{display:flex;gap:6px;align-items:center}
  .keyrow code{flex:1;font-size:11px;word-break:break-all;background:var(--panel);border:1px solid var(--line);border-radius:7px;padding:6px 8px}
  .keyrow input{flex:1;border:1px solid var(--line);border-radius:7px;padding:6px 8px;font-size:12px}
  .btn.small{padding:6px 10px;font-size:12.5px}
  .members{display:flex;flex-direction:column;gap:2px;max-height:200px;overflow:auto;border:1px solid var(--line);border-radius:9px;padding:6px}
  .mem{display:flex;gap:8px;align-items:center;padding:5px 6px;border-radius:6px;cursor:pointer;font-size:13.5px}
  .mem:hover{background:var(--soft)}
  .mem.all{border-bottom:1px solid var(--line);border-radius:0;margin-bottom:2px}
  .status{font-size:12px;color:var(--muted);margin-top:auto;line-height:1.4}
  .status.warn{color:#c2410c}

  main{padding:20px 24px;display:flex;flex-direction:column;gap:14px;min-width:0}
  .toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .toolbar h2{margin:0 8px 0 0;font-size:22px;font-weight:700;letter-spacing:-.01em;text-transform:capitalize;min-width:200px}
  .iconbtn{border:1px solid var(--line);background:var(--panel);border-radius:9px;width:36px;height:36px;display:grid;place-items:center}
  .iconbtn:hover{background:var(--soft)}
  .pill{border:1px solid var(--line);background:var(--panel);border-radius:9px;padding:0 14px;height:36px;font-weight:500}
  .pill:hover{background:var(--soft)}
  .seg{display:flex;border:1px solid var(--line);border-radius:9px;overflow:hidden;margin-left:auto}
  .seg button{border:0;background:var(--panel);padding:0 14px;height:34px;font-weight:500}
  .seg button[aria-pressed="true"]{background:var(--accent);color:var(--panel)}

  .cal{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;display:flex;flex-direction:column;flex:1}
  .dow{display:grid;grid-template-columns:repeat(7,1fr);border-bottom:1px solid var(--line)}
  .dow div{padding:10px 10px;font-size:12px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
  .grid{display:grid;grid-template-columns:repeat(7,1fr);grid-auto-rows:minmax(118px,1fr);flex:1}
  .day{border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:6px;display:flex;flex-direction:column;gap:3px;min-width:0;cursor:pointer;position:relative}
  .day:nth-child(7n){border-right:0}
  .day:hover{background:var(--soft)}
  .day.other{background:color-mix(in srgb,var(--bg) 60%,transparent)}
  .day.other .num{color:var(--muted);opacity:.6}
  .num{font-size:12.5px;font-weight:600;width:24px;height:24px;display:grid;place-items:center;border-radius:50%;margin-bottom:2px}
  .day.today .num{background:var(--today);color:var(--panel)}
  .ev{display:flex;align-items:center;gap:5px;padding:3px 6px;border-radius:6px;background:var(--bg-c);color:var(--ink);font-size:12px;border:0;border-left:3px solid var(--c);text-align:left;width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.35}
  .ev:hover{filter:brightness(.97)}
  .ev.race{font-weight:700}
  .chooser{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .choice{display:flex;flex-direction:column;align-items:center;gap:4px;padding:18px 10px;border-radius:12px;border:1.5px solid var(--line);background:var(--panel);text-align:center}
  .choice:hover{filter:brightness(.97)}
  .choice.train{border-color:var(--accent)}
  .choice.race{border-color:var(--race);background:var(--race-bg)}
  .choice .ce{font-size:24px}
  .choice .ct{font-weight:700;font-size:15px}
  .choice .cs{font-size:12px;color:var(--muted)}
  .linkprev{display:block;margin-top:6px;font-size:12.5px;color:var(--swim);word-break:break-all}
  .repeat{background:var(--soft);border-radius:10px;padding:10px 12px;display:flex;flex-direction:column;gap:8px}
  .chk{display:flex;gap:8px;align-items:center;font-size:13.5px;cursor:pointer}
  .detail a{color:var(--swim)}
  .ev .tm{font-weight:600;font-variant-numeric:tabular-nums;flex:none}
  .ev .tt{overflow:hidden;text-overflow:ellipsis}
  .more{font-size:11.5px;color:var(--muted);background:none;border:0;text-align:left;padding:1px 6px}

  .list{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:6px 0}
  .list-day{padding:12px 18px 4px;font-size:12px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
  .list-ev{display:flex;gap:14px;align-items:center;padding:10px 18px;border:0;background:none;width:100%;text-align:left}
  .list-ev:hover{background:var(--soft)}
  .list-ev .dot{width:34px;height:34px;border-radius:9px;background:var(--bg-c);display:grid;place-items:center;font-size:17px;flex:none}
  .list-ev .info{flex:1;min-width:0}
  .list-ev .t{font-weight:600}
  .list-ev .m{color:var(--muted);font-size:12.5px;margin-top:2px}
  .list-ev .who{font-size:12px;color:var(--muted);white-space:nowrap}

  /* modal */
  .scrim{position:fixed;inset:0;background:rgba(10,12,15,.45);display:none;align-items:center;justify-content:center;padding:16px;z-index:20}
  .scrim.open{display:flex}
  .modal{background:var(--panel);border-radius:16px;width:100%;max-width:480px;max-height:calc(100vh - 32px);overflow:auto;box-shadow:0 20px 50px rgba(0,0,0,.25)}
  .modal header{display:flex;align-items:center;justify-content:space-between;padding:18px 20px 6px}
  .modal header h3{margin:0;font-size:17px}
  .modal .body{padding:8px 20px 4px;display:flex;flex-direction:column;gap:12px}
  .modal footer{display:flex;gap:8px;justify-content:flex-end;padding:14px 20px 18px;flex-wrap:wrap}
  label.f{display:flex;flex-direction:column;gap:5px;font-size:12.5px;font-weight:500;color:var(--muted)}
  label.f input,label.f select,label.f textarea{border:1px solid var(--line);border-radius:9px;padding:9px 11px;font-size:14px;width:100%}
  label.f textarea{resize:vertical;min-height:70px}
  .row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .row3{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:10px}
  .sportpick{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
  .sportpick.five{grid-template-columns:repeat(5,1fr)}
  .sportpick.five label{font-size:11px}
  .sportpick label{border:1.5px solid var(--line);border-radius:10px;padding:8px 4px;text-align:center;cursor:pointer;font-size:12px;font-weight:500;display:flex;flex-direction:column;gap:2px;align-items:center}
  .sportpick label span.e{font-size:18px}
  .sportpick input{position:absolute;opacity:0;pointer-events:none}
  .sportpick input:checked + label{border-color:var(--c);background:var(--bg-c)}
  .sportpick input:focus-visible + label{outline:2px solid var(--c);outline-offset:1px}
  .btn{border:1px solid var(--line);background:var(--panel);border-radius:9px;padding:9px 14px;font-weight:500}
  .btn:hover{background:var(--soft)}
  .btn.dark{background:var(--accent);color:var(--panel);border-color:var(--accent)}
  .btn.danger{color:#c0392b;border-color:color-mix(in srgb,#c0392b 40%,var(--line))}
  .btn.danger.confirm{background:#c0392b;color:#fff;border-color:#c0392b}
  .spacer{flex:1}
  .detail{display:flex;flex-direction:column;gap:10px;padding:4px 20px 0}
  .detail .tag{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;background:var(--bg-c);font-size:12.5px;font-weight:600;align-self:flex-start}
  .detail .line{display:flex;gap:10px;align-items:flex-start;font-size:14px}
  .detail .line .k{width:22px;text-align:center;flex:none;color:var(--muted)}
  .detail .desc{white-space:pre-wrap;background:var(--soft);border-radius:10px;padding:10px 12px;font-size:13.5px}
  .att{display:flex;flex-wrap:wrap;gap:6px}
  .att span{background:var(--soft);border-radius:999px;padding:3px 10px;font-size:12.5px}
  .err{color:#c0392b;font-size:12.5px;min-height:1em}
  .x{border:0;background:none;font-size:22px;line-height:1;color:var(--muted);padding:4px 6px}

  .menu-toggle{display:none}
  @media (max-width:860px){
    .app{grid-template-columns:1fr}
    aside{border-right:0;border-bottom:1px solid var(--line);gap:14px}
    .upcoming-wrap{display:none}
    .status{margin-top:0}
    .filters{flex-direction:row;flex-wrap:wrap}
    .filter{padding:6px 10px;background:var(--soft)}
    .filter .count{display:none}
    main{padding:14px 12px}
    .toolbar h2{font-size:18px;min-width:0;flex:1}
    .grid{grid-auto-rows:minmax(74px,1fr)}
    .ev .tt{display:none}
    .ev{padding:2px 4px;justify-content:center}
    .dow div{padding:8px 4px;text-align:center}
    .seg{margin-left:0}
  }
</style>
</head>
<body>
<div class="app">
  <aside>
    <div class="brand">
      <h1>VESC közös edzések</h1>
      <p>Írd be, ha közös edzést szervezel, és nézd meg, ki jön.</p>
      <div class="me" id="me"></div>
    </div>
    <button class="btn-primary" id="addBtn">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      Új közös edzés
    </button>
    <button class="btn-secondary" id="addRaceBtn">🏆 Új verseny</button>
    <div>
      <p class="section-title">Sportágak</p>
      <div class="filters" id="filters"></div>
      <div class="filter-actions">
        <button class="linkbtn" id="allOn">Mind</button>
        <button class="linkbtn" id="allOff">Egyik sem</button>
      </div>
    </div>
    <div class="upcoming-wrap">
      <p class="section-title">Következő edzések</p>
      <div class="upcoming" id="upcoming"><div class="empty">Betöltés…</div></div>
    </div>
    <div class="status" id="status">Kapcsolódás…</div>
  </aside>

  <main>
    <div class="toolbar">
      <button class="iconbtn" id="prev" aria-label="Előző">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="iconbtn" id="next" aria-label="Következő">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="pill" id="todayBtn">Ma</button>
      <h2 id="title"></h2>
      <div class="seg" role="group" aria-label="Nézet">
        <button id="vMonth" aria-pressed="true">Hónap</button>
        <button id="vList" aria-pressed="false">Lista</button>
      </div>
    </div>
    <div id="view"></div>
  </main>
</div>

<!-- modal -->
<div class="scrim" id="scrim">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="mTitle">
    <header><h3 id="mTitle"></h3><button class="x" id="mClose" aria-label="Bezárás">×</button></header>
    <div id="mContent"></div>
  </div>
</div>

<script>
const SPORTS = {
  run:   { name:"Futás",            emoji:"🏃‍♂️", c:"var(--run)",   bg:"var(--run-bg)" },
  bike:  { name:"Kerékpározás",     emoji:"🚴‍♂️", c:"var(--bike)",  bg:"var(--bike-bg)" },
  swim:  { name:"Úszás",            emoji:"🏊‍♂️", c:"var(--swim)",  bg:"var(--swim-bg)" },
  other: { name:"Erőnlét / Egyéb",  emoji:"🏋️‍♂️", c:"var(--other)", bg:"var(--other-bg)" },
  race:  { name:"Versenyek",        emoji:"🏆", c:"var(--race)",  bg:"var(--race-bg)", short:"Verseny" },
};
const RACE_TYPES = {
  tri:   { name:"Triatlon",        short:"Triatlon", emoji:"🏊‍♂️" },
  du:    { name:"Duatlon",         short:"Duatlon",  emoji:"🔁" },
  run:   { name:"Futóverseny",     short:"Futás",    emoji:"🏃‍♂️" },
  bike:  { name:"Kerékpárverseny", short:"Kerékpár", emoji:"🚴‍♂️" },
  other: { name:"Egyéb verseny",   short:"Egyéb",    emoji:"🏅" },
};
const raceLabel = e => (RACE_TYPES[e.raceType]||{name:"Verseny"}).name;
const MONTHS = ["január","február","március","április","május","június","július","augusztus","szeptember","október","november","december"];
const DOW = ["H","K","Sze","Cs","P","Szo","V"];
const DOW_LONG = ["vasárnap","hétfő","kedd","szerda","csütörtök","péntek","szombat"];

const state = { events: [], cursor: new Date(), view: "month", enabled: loadFilters(), loaded: false, me: loadName(), key: loadKey(), adminPw: store("vesc-admin")||"", isAdmin: false };
state.cursor.setDate(1);

function store(k, v){ try{ if(v===undefined) return localStorage.getItem(k); localStorage.setItem(k, v); }catch(e){ return null; } }
function loadFilters(){
  try{ const v = JSON.parse(store("vesc-filters")||"null"); if(v && typeof v==="object") return Object.assign({run:true,bike:true,swim:true,other:true,race:true}, v); }catch(e){}
  return {run:true,bike:true,swim:true,other:true,race:true};
}
function saveFilters(){ store("vesc-filters", JSON.stringify(state.enabled)); }
function loadName(){ return (store("vesc-name")||"").trim(); }
function newKey(){ const a=new Uint8Array(20); crypto.getRandomValues(a); return Array.from(a,b=>b.toString(16).padStart(2,"0")).join(""); }
function loadKey(){ let k=(store("vesc-key")||"").trim(); if(!/^[a-f0-9]{32,64}$/.test(k)){ k=newKey(); store("vesc-key",k); } return k; }
const auth = () => ({ key: state.key, adminPw: state.adminPw });
function apply(d){ if(d && d.events){ state.events=d.events; state.isAdmin=!!d.isAdmin; } }

const pad = n => String(n).padStart(2,"0");
const ymd = d => d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate());
const parseYmd = s => { const [y,m,d]=s.split("-").map(Number); return new Date(y,m-1,d); };
const todayStr = () => ymd(new Date());
function fmtDayLong(s){ const d=parseYmd(s); return `${d.getFullYear()}. ${MONTHS[d.getMonth()]} ${d.getDate()}., ${DOW_LONG[d.getDay()]}`; }
function fmtDayShort(s){ const d=parseYmd(s); return `${MONTHS[d.getMonth()].slice(0,3)}. ${d.getDate()}. ${DOW_LONG[d.getDay()]}`; }
function el(tag, attrs={}, ...kids){
  const e=document.createElement(tag);
  for(const [k,v] of Object.entries(attrs)){
    if(k==="class") e.className=v;
    else if(k==="style") e.setAttribute("style",v);
    else if(k.startsWith("on")) e.addEventListener(k.slice(2),v);
    else if(v!==false && v!=null) e.setAttribute(k,v===true?"":v);
  }
  for(const k of kids.flat()){ if(k==null||k===false) continue; e.append(k instanceof Node?k:document.createTextNode(String(k))); }
  return e;
}
const sportOf = ev => SPORTS[ev.sport] ? ev.sport : "other";
const visible = () => state.events.filter(e => /^\d{4}-\d{2}-\d{2}$/.test(e.date) && state.enabled[sportOf(e)]);
const sortEv = (a,b) => (a.date+(a.start||"99:99")).localeCompare(b.date+(b.start||"99:99"));
const iGo = e => !!state.me && (e.attendees||[]).some(n => n.toLowerCase()===state.me.toLowerCase());

/* ---------- server calls ---------- */
// A naptár háttere (Google Apps Script webalkalmazás /exec címe)
const API_URL = "https://script.google.com/macros/s/AKfycbwXvZQZjhAbtiI8rFmPGGRYvB7bGssHzVaD2H7EJnPn71f1lWB3KcSn5N_QDJmrGromRA/exec";
const inAppsScript = typeof google!=="undefined" && google.script && google.script.run;
function call(fn, ...args){
  if(inAppsScript) return new Promise((res, rej) => {
    google.script.run.withSuccessHandler(res).withFailureHandler(rej)[fn](...args);
  });
  // külső weboldalról: sima kérés, Google-bejelentkezés (süti) nélkül
  return fetch(API_URL, { method:"POST", redirect:"follow", credentials:"omit",
      headers:{ "Content-Type":"text/plain;charset=utf-8" }, body: JSON.stringify({ fn, args }) })
    .then(r => { if(!r.ok) throw new Error("A naptár szervere nem érhető el ("+r.status+")."); return r.json(); })
    .then(d => { if(!d || !d.ok) throw new Error((d && d.error) || "Ismeretlen hiba."); return d.result; });
}
async function refresh(){
  try{
    apply(await call("getData", auth())); state.loaded = true;
