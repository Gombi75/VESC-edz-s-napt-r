function renderMonth(){
  const view=document.getElementById("view"); view.textContent="";
  const cal=el("div",{class:"cal"});
  const dow=el("div",{class:"dow"}, DOW.map(d=>el("div",{},d)));
  const grid=el("div",{class:"grid"});
  const first=new Date(state.cursor); const m=first.getMonth();
  const offset=(first.getDay()+6)%7;
  const start=new Date(first); start.setDate(1-offset);
  const last=new Date(first.getFullYear(),m+1,0);
  const totalCells=Math.ceil((offset+last.getDate())/7)*7;
  const byDay={};
  visible().forEach(e=>{ (byDay[e.date] = byDay[e.date] || []).push(e); });
  const t=todayStr();
  const small = matchMedia("(max-width:860px)").matches;
  const maxShow = small ? 3 : 4;
  for(let i=0;i<totalCells;i++){
    const d=new Date(start); d.setDate(start.getDate()+i);
    const key=ymd(d);
    const evs=(byDay[key]||[]).sort(sortEv);
    const cell=el("div",{class:"day"+(d.getMonth()!==m?" other":"")+(key===t?" today":"")}, el("div",{class:"num"},d.getDate()));
    cell.addEventListener("click",ev=>{ if(ev.target===cell||ev.target.classList.contains("num")) openChooser(key); });
    evs.slice(0, evs.length>maxShow? maxShow-1 : maxShow).forEach(e=>{
      const s=SPORTS[sportOf(e)];
      cell.append(el("button",{class:"ev"+(e.sport==="race"?" race":""),style:`--c:${s.c};--bg-c:${s.bg}`,title:`${s.name}: ${e.title||""} ${e.start||""}`,onclick:(x)=>{x.stopPropagation();openDetail(e.id);}},
        small ? s.emoji : (e.start? el("span",{class:"tm"},e.start):null),
        el("span",{class:"tt"},(small?"":s.emoji+" ")+(e.title||s.name))));
    });
    if(evs.length>maxShow) cell.append(el("button",{class:"more",onclick:(x)=>{x.stopPropagation();openDay(key);}},`+${evs.length-maxShow+1} további`));
    grid.append(cell);
  }
  cal.append(dow,grid); view.append(cal);
}
